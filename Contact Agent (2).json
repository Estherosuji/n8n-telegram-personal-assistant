    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst input = $('When Executed by Another Workflow').first().json;\nconst searchName = input.name?.toLowerCase() || '';\n\nconst match = items.find(function(item) {\nconst name = (item.json.names && item.json.names.displayName) || '';\nreturn name.toLowerCase().indexOf(searchName) !== -1;\n});\n\nif (!match) {\nreturn [{ json: { error: 'Contact not found', contactId: null } }];\n}\n\nconst resourceName = match.json.resourceName;\nconst contactId = resourceName.replace('people/', '');\n\nreturn [{ json: {\ncontactId,\nresourceName,\nname: match.json.names.displayName,\nemail: input.email || null,\nphone: input.phone || null,\nfirstName: input.firstName || null,\nlastName: input.lastName || null\n} }];\n"
      },
