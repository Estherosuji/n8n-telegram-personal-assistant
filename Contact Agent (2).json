    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst searchName = $('When Executed by Another Workflow').first().json.name?.toLowerCase() || '';\n\nconst match = items.find(item => {\nconst name = item.json.names?.displayName || '';\nreturn name.toLowerCase().includes(searchName);\n});\n\nif (!match) {\nreturn [{ json: { error: 'Contact not found', contactId: null } }];\n}\n\nconst resourceName = match.json.resourceName;\nconst contactId = resourceName.replace('people/', '');\n\nreturn [{ json: { contactId, resourceName, name: match.json.names?.displayName } }];\n"
      },
